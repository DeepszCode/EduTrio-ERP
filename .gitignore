```gitignore
# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ==========================================
# Node.js and React frontend
# ==========================================
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/
.eslintcache

# ==========================================
# Build output
# ==========================================
dist/
**/dist/
build/
**/build/
coverage/
*.tsbuildinfo

# ==========================================
# Python backend
# ==========================================
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.python-version

# Python virtual environments
.venv/
**/.venv/
venv/
**/venv/
env/
ENV/

# Python package and build files
develop-eggs/
downloads/
eggs/
.eggs/
wheels/
pip-wheel-metadata/
*.egg-info/
*.egg

# ==========================================
# OCR and AI temporary files
# ==========================================
temp/
**/temp/
tmp/
**/tmp/
uploads/
**/uploads/
output/
**/output/
outputs/
**/outputs/
*.tmp
*.temp

# ==========================================
# Databases and logs
# ==========================================
*.db
*.sqlite
*.sqlite3
*.log
logs/
**/logs/

# ==========================================
# Private documents and certificates
# ==========================================
private_documents/
**/private_documents/
private_certificates/
**/private_certificates/

# ==========================================
# Local configuration and secrets
# ==========================================
*.pem
*.key
*.p12
*.pfx
secrets/
**/secrets/

# ==========================================
# IDE and operating system files
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Test and cache files
# ==========================================
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.cache/
**/.cache/
